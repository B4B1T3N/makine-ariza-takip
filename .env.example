# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi yazın.
# .env dosyası .gitignore içindedir, asla depoya gönderilmez.

# PostgreSQL bağlantı adresi.
# Yerel geliştirme:
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/ariza_takip
# Bulut sağlayıcı örneği (Neon/Supabase/Railway SSL ister):
# DATABASE_URL=postgresql://kullanici:sifre@sunucu.neon.tech/ariza_takip?sslmode=require

# Testler bu veritabanını kullanır ve her testte içeriğini siler.
# Üretim veritabanını ASLA buraya yazmayın.
TEST_DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/ariza_takip_test

# Tesisin saat dilimi. Raporlardaki gün sınırları buna göre hesaplanır.
MAT_TIMEZONE=Europe/Istanbul

# Bağlantı havuzu üst sınırı.
MAT_DB_POOL_MAX=8

# Oturum çerezini imzalayan anahtar (Faz 2).
# Tanımlanmazsa üretilip veritabanına yazılır; üretimde burada tanımlayın ki
# anahtar veritabanı yedeklerinin içinde dolaşmasın.
# Üretmek için:  python -c "import secrets; print(secrets.token_urlsafe(48))"
MAT_SECRET_KEY=

# --- Ek dosyaları (Faz 4) ---
# yerel = sunucunun diski (varsayılan), s3 = S3 uyumlu nesne depolama.
# Birden fazla uygulama örneği çalışacaksa yerel disk ortak değildir; s3 seçin.
MAT_STORAGE=yerel

# MAT_STORAGE=s3 seçildiyse doldurun. Endpoint boş bırakılırsa AWS kullanılır;
# MinIO / Cloudflare R2 / DigitalOcean Spaces için servisin adresini yazın.
# MAT_S3_BUCKET=ariza-ekleri
# MAT_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# MAT_S3_REGION=eu-central-1
# MAT_S3_ACCESS_KEY=
# MAT_S3_SECRET_KEY=
# MAT_S3_PREFIX=ekler

# --- Yayın (Faz 5) ---
# Uygulama TLS sonlandıran bir vekilin arkasındaysa 1 yapın: oturum çerezi
# yalnızca güvenli bağlantıda gönderilir ve HSTS başlığı eklenir.
MAT_HTTPS=0

# X-Forwarded-For / X-Forwarded-Proto başlıklarına güvenilsin mi. YALNIZCA
# önünüzde kendi ters vekiliniz varsa 1 yapın; aksi halde istemci bu başlığı
# uydurup giriş hız sınırını başka bir adresin üzerine yıkabilir.
MAT_TRUST_PROXY=0

# Giriş hız sınırı: kullanıcı adı başına deneme, pencere (dakika) ve aynı
# adresten gelen toplam deneme sınırı.
MAT_LOGIN_MAX_ATTEMPTS=5
MAT_LOGIN_WINDOW_MINUTES=15
MAT_LOGIN_MAX_PER_ADDRESS=20

# Son yedek bu yaşı geçerse yöneticinin panelinde uyarı çıkar.
MAT_BACKUP_WARN_DAYS=8
