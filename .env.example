# Bu dosyayı ".env" adıyla kopyalayıp kendi değerlerinizi yazın.
# .env dosyası .gitignore içindedir, asla depoya gönderilmez.

# PostgreSQL bağlantı adresi.
# Yerel geliştirme:
DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/ariza_takip
# Bulut sağlayıcı örneği (Neon/Supabase/Railway SSL ister):
# DATABASE_URL=postgresql://kullanici:sifre@sunucu.neon.tech/ariza_takip?sslmode=require

# Testler bu veritabanını kullanır ve her testte içeriğini siler.
# Üretim veritabanını ASLA buraya yazmayın.
TEST_DATABASE_URL=postgresql://postgres:SIFRENIZ@localhost:5432/ariza_takip_test

# Tesisin saat dilimi. Raporlardaki gün sınırları buna göre hesaplanır.
MAT_TIMEZONE=Europe/Istanbul

# Bağlantı havuzu üst sınırı.
MAT_DB_POOL_MAX=8
